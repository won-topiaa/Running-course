# 외부 서비스 키 (모두 선택 — 없어도 앱은 OSM/오프라인 데모로 동작)
# 앱 실행 후 [마이 페이지 → 외부 서비스 연동] 에서 직접 붙여넣어도 됩니다.

# 카카오맵 JavaScript 키 — 기본 지도(한국). 없으면 OpenStreetMap 으로 폴백.
# 발급: https://developers.kakao.com/console/app → 앱 키 → JavaScript 키
# ※ 카카오 개발자 콘솔의 Web 플랫폼에 배포 도메인을 등록해야 지도가 표시됩니다.
VITE_KAKAO_JS_KEY=

# Mapbox access token — 카카오 대신 쓰고 싶을 때(선택). 없으면 OpenStreetMap.
# 발급: https://account.mapbox.com/access-tokens/  (pk. 로 시작하는 public token)
VITE_MAPBOX_TOKEN=

# OpenRouteService API 키 — '코스 만들기'의 실제 도로 도보 경로 + 구간별 경사.
# 발급: https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=

# Strava 연동 Worker 주소 (선택) — 자동 업로드용.
# 없어도 GPX 내보내기 → Strava 수동 업로드는 그대로 됩니다.
# server/strava-worker 를 배포한 뒤 나오는 주소를 넣으세요.
VITE_STRAVA_WORKER_URL=
